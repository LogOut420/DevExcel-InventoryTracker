@model InventoryTracker.Web.Services.ProductFormDto
@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none">&larr; Back to Product List</a>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Add New Product</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Sku" class="form-label fw-semibold">SKU (Unique Code)</label>
                        <input asp-for="Sku" class="form-control" maxlength="50" required />
                        <div class="form-text">Auto-generated suggestion provided; editable if custom SKU is needed.</div>
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                        <input asp-for="Name" class="form-control" maxlength="150" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReorderLevel" class="form-label fw-semibold">Reorder Level (Low Stock Threshold)</label>
                        <input asp-for="ReorderLevel" type="number" min="0" class="form-control" required />
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

