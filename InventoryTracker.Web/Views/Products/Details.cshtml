@using InventoryTracker.Web.Models
@model InventoryTracker.Web.Services.ProductDetailDto
@{
    ViewData["Title"] = $"{Model.Sku} - {Model.Name}";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Product List</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Action Blocked:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Product Info + Record Movement -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge bg-dark mb-1">@Model.Sku</span>
                        <h3 class="mb-1">@Model.Name</h3>
                    </div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </div>
                <p class="text-muted mb-3">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>

                <div class="p-3 rounded bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Derived Current Stock</div>
                        <div class="display-6 fw-bold @(Model.IsLowStock ? "text-danger" : "text-success")">@Model.CurrentStock</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Reorder Level: <strong>@Model.ReorderLevel</strong></div>
                        @if (!Model.IsActive)
                        {
                            <span class="badge bg-secondary mt-1">Inactive</span>
                        }
                        else if (Model.IsLowStock)
                        {
                            <span class="badge bg-danger mt-1">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success mt-1">Healthy Stock</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Record Movement Form -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Record Stock Movement</div>
            <div class="card-body">
                @if (!Model.IsActive)
                {
                    <div class="alert alert-warning mb-0">
                        This product is inactive. Activate it from the product list to record new stock movements.
                    </div>
                }
                else
                {
                    <form asp-action="RecordMovement" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Movement Type</label>
                            <select name="type" class="form-select" required>
                                <option value="@MovementType.In">Stock In (+ Receive / Restock)</option>
                                <option value="@MovementType.Out">Stock Out (- Issue / Dispatch)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Quantity</label>
                            <input type="number" name="quantity" class="form-control" min="1" step="1" value="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Note / Reference (Optional)</label>
                            <input type="text" name="note" class="form-control" maxlength="250" placeholder="e.g., PO #1042 or Issued to Sales" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Save Movement</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Chronological Ledger -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Stock Movement Ledger (@Model.Movements.Count)</span>
                @if (Model.Movements.Any())
                {
                    <a asp-action="ExportMovementsCsv" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success">
                        Export CSV
                    </a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Type</th>
                            <th class="text-end">Quantity</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Movements.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No stock movements recorded yet. Use the form on the left to record an <strong>In</strong> movement.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var m in Model.Movements)
                            {
                                <tr>
                                    <td class="small text-muted">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        @if (m.Type == MovementType.In)
                                        {
                                            <span class="badge bg-success">IN (+)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">OUT (-)</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">@(m.Type == MovementType.In ? $"+{m.Quantity}" : $"-{m.Quantity}")</td>
                                    <td>@(string.IsNullOrWhiteSpace(m.Note) ? "-" : m.Note)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


