@model InventoryTracker.Web.Services.PagedResult<InventoryTracker.Web.Services.ProductSummaryDto>
@{
    ViewData["Title"] = "Inventory Products";
    var pageProducts = Model.Items;
    var stats = ViewBag.Stats as InventoryTracker.Web.Services.DashboardStatsDto;
    var totalActiveSkus = stats?.TotalActiveSkus ?? 0;
    var totalUnits = stats?.TotalUnitsOnHand ?? 0;
    var belowReorderCount = stats?.BelowReorderCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Inventory Tracker</h2>
        <small class="text-muted">Derived stock levels from movement ledger</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards (Global Inventory Totals) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Active SKUs</div>
                <div class="fs-4 fw-bold">@totalActiveSkus</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Active Units on Hand</div>
                <div class="fs-4 fw-bold text-primary">@totalUnits</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Below Reorder Level</div>
                <div class="fs-4 fw-bold @(belowReorderCount > 0 ? "text-danger" : "text-success")">@belowReorderCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by SKU or Product Name..." />
        </div>
        <div class="col-md-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="showInactive" value="true" id="showInactiveCheck" @(ViewBag.ShowInactive == true ? "checked" : "") />
                <input type="hidden" name="showInactive" value="false" />
                <label class="form-check-label" for="showInactiveCheck">Include inactive</label>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="lowStockOnly" value="true" id="lowStockCheck" @(ViewBag.LowStockOnly == true ? "checked" : "") />
                <input type="hidden" name="lowStockOnly" value="false" />
                <label class="form-check-label text-danger fw-semibold" for="lowStockCheck">Low stock only</label>
            </div>
        </div>
        <div class="col-md-3 text-md-end">
            <button type="submit" class="btn btn-outline-primary me-1">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<!-- Products Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Product Name</th>
                    <th class="text-end">Current Stock</th>
                    <th class="text-end">Reorder Level</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!pageProducts.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No products found matching your criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in pageProducts)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary text-muted" : "")">
                            <td class="fw-semibold"><code>@item.Sku</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">
                                    @item.Name
                                </a>
                            </td>
                            <td class="text-end fw-bold">@item.CurrentStock</td>
                            <td class="text-end">@item.ReorderLevel</td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge bg-danger">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Movements</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-showInactive="@ViewBag.ShowInactive"
                           asp-route-lowStockOnly="@ViewBag.LowStockOnly"
                           asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@ViewBag.Search"
                               asp-route-showInactive="@ViewBag.ShowInactive"
                               asp-route-lowStockOnly="@ViewBag.LowStockOnly"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-search="@ViewBag.Search"
                           asp-route-showInactive="@ViewBag.ShowInactive"
                           asp-route-lowStockOnly="@ViewBag.LowStockOnly"
                           asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>