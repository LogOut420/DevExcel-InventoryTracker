@model List<InventoryTracker.Web.Services.ProductSummaryDto>
@{
    ViewData["Title"] = "Inventory Products";
    var totalProducts = Model.Count;
    var lowStockCount = Model.Count(p => p.IsActive && p.IsLowStock);
    var totalUnits = Model.Where(p => p.IsActive).Sum(p => p.CurrentStock);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Inventory Tracker</h2>
        <small class="text-muted">Derived stock levels from movement ledger</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Products</div>
                <div class="fs-4 fw-bold">@totalProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Active Units on Hand</div>
                <div class="fs-4 fw-bold text-primary">@totalUnits</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Low Stock Alerts</div>
                <div class="fs-4 fw-bold @(lowStockCount > 0 ? "text-danger" : "text-success")">@lowStockCount</div>
            </div>
        </div>
    </div>
</div>


<!-- Search & Filter Bar -->
<form method="get" asp-action="Index" class="card card-body border-0 shadow-sm mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by SKU or Product Name..." />
        </div>
        <div class="col-md-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="showInactive" value="true" id="showInactiveCheck" @(ViewBag.ShowInactive == true ? "checked" : "") />
                <input type="hidden" name="showInactive" value="false" />
                <label class="form-check-label" for="showInactiveCheck">Include inactive products</label>
            </div>
        </div>
        <div class="col-md-3 text-md-end">
            <button type="submit" class="btn btn-outline-primary me-1">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>


<!-- Products Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Product Name</th>
                    <th class="text-end">Current Stock</th>
                    <th class="text-end">Reorder Level</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No products found. Click <strong>+ Add New Product</strong> to get started.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary text-muted" : "")">
                            <td class="fw-semibold"><code>@item.Sku</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">
                                    @item.Name
                                </a>
                            </td>
                            <td class="text-end fw-bold">@item.CurrentStock</td>
                            <td class="text-end">@item.ReorderLevel</td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge bg-danger">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Movements</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


